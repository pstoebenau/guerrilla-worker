{
  "name": "guerrilla-worker",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "bun agent/main.ts",
    "build": "bun build agent/main.ts --target=node --outfile=dist/worker.mjs",
    "build:windows": "bun scripts/build-windows.ts",
    "build:installer": "bun scripts/build-windows.ts -Installer",
    "check": "tsc --noEmit",
    "test": "bun test tests",
    "test:pipeline": "cd pipeline && bun ../scripts/python.mjs -m unittest discover -s tests",
    "scan": "bun scripts/python.mjs pipeline/run_scan.py"
  },
  "dependencies": {
    "@guerrilla/worker-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "5.9.3"
  }
}
