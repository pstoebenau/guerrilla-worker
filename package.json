{
  "name": "guerrilla-worker",
  "version": "0.3.4",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run tauri dev",
    "build": "bun run tauri build",
    "tauri": "bun scripts/tauri.ts",
    "build:docker": "bun scripts/build-docker.ts",
    "check": "tsc --noEmit",
    "check:python": "pyright --project pipeline/pyrightconfig.json",
    "test": "bun test tests",
    "test:rust": "cargo test --locked --workspace",
    "test:python": "PYTHONPATH=pipeline bun scripts/python.mjs -m unittest discover -s pipeline/tests"
  },
  "dependencies": {
    "@guerrilla/worker-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "5.9.3",
    "pyright": "1.1.407"
  }
}
