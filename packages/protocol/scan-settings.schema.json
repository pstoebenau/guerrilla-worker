{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scan settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "extraction": {
      "type": "object",
      "title": "Frame extraction",
      "additionalProperties": false,
      "properties": {
        "skip": {
          "type": "integer",
          "title": "Candidate interval",
          "description": "Frames per candidate group.",
          "default": 10,
          "minimum": 1,
          "maximum": 100000
        },
        "keep": {
          "type": "integer",
          "title": "Frames per group",
          "description": "Sharp frames retained from each candidate group.",
          "default": 5,
          "minimum": 1,
          "maximum": 100000
        },
        "max_frames": {
          "type": "integer",
          "title": "Maximum frames",
          "description": "Maximum extracted frames.",
          "default": 300,
          "minimum": 1,
          "maximum": 100000
        },
        "quality": {
          "type": "integer",
          "title": "JPEG quality",
          "description": "JPEG quality for extracted frames.",
          "default": 95,
          "minimum": 0,
          "maximum": 100
        },
        "scale": {
          "type": "number",
          "title": "Image scale",
          "description": "Scale applied to extracted frames.",
          "default": 1,
          "minimum": 0.01,
          "maximum": 1
        }
      }
    },
    "reconstruction": {
      "type": "object",
      "title": "Camera reconstruction",
      "additionalProperties": false,
      "properties": {}
    },
    "densification": {
      "type": "object",
      "title": "Dense point cloud",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable densification",
          "description": "Build a dense point cloud with the balanced preset before training.",
          "default": true
        }
      }
    },
    "training": {
      "type": "object",
      "title": "Training",
      "additionalProperties": false,
      "properties": {
        "iterations": {
          "type": "integer",
          "title": "Iterations",
          "description": "Number of training iterations.",
          "default": 30000,
          "minimum": 1,
          "maximum": 1000000
        }
      }
    }
  }
}
