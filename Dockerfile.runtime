# syntax=docker/dockerfile:1
FROM ubuntu:24.04 AS spirula-download
ARG TARGETARCH
ARG SPIRULA_VERSION=2026.10.16
ARG SPIRULA_SHA256=df5bb7acbfea63c16497c229b70c7a05ed13c22807554dee83cd6415aa411bf3
RUN test "${TARGETARCH}" = amd64 \
    && apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/spirula && curl -fL --retry 3 \
      https://github.com/harry7557558/spirula-studio/releases/download/v${SPIRULA_VERSION}/spirula-${SPIRULA_VERSION}-ubuntu-vulkan-x86_64.zip \
      -o /tmp/spirula.zip \
    && echo "${SPIRULA_SHA256}  /tmp/spirula.zip" | sha256sum -c - \
    && unzip -q /tmp/spirula.zip -d /opt/spirula && rm /tmp/spirula.zip \
    && executable="$(find /opt/spirula -type f -name spirula | head -1)" \
    && test -n "$executable" && chmod +x "$executable" \
    && if [ "$executable" != /opt/spirula/spirula ]; then ln -s "$executable" /opt/spirula/spirula; fi
ARG ROMAV2_SHA256=1557dec0d21b62366465f7ff4d5fdf228cc695d0582e196ad2b80e05230828b7
RUN mkdir -p /opt/models \
    && curl -fL --retry 3 https://github.com/Parskatt/RoMaV2/releases/download/v2.0.1/romav2.0.1.pt -o /opt/models/romav2.0.1.pt \
    && echo "${ROMAV2_SHA256}  /opt/models/romav2.0.1.pt" | sha256sum -c -

FROM node:22.22.0-bookworm-slim AS converter
WORKDIR /opt/converter
COPY pipeline/docker/converter/package*.json ./
RUN npm ci --omit=dev --ignore-scripts && node node_modules/@playcanvas/splat-transform/bin/cli.mjs --version

FROM ubuntu:24.04 AS spirula-runtime
ENV DEBIAN_FRONTEND=noninteractive NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,video
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates ffmpeg libglib2.0-0t64 libgomp1 libgl1 libstdc++6 libgcc-s1 \
    libgtk-3-0t64 libx11-6 libxext6 libxrender1 libxi6 libxrandr2 libxinerama1 \
    libxcursor1 libsm6 libice6 libwayland-client0 libwayland-cursor0 libwayland-egl1 \
    libxkbcommon0 libegl1 libdecor-0-0 libdbus-1-3 libvulkan1 libopengl0 libgfortran5 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=converter /usr/local/bin/node /usr/local/bin/node
COPY --from=converter /opt/converter /opt/converter
COPY --from=spirula-download /opt/spirula /opt/spirula
COPY --from=spirula-download /opt/models /opt/models
ENV SPIRULA_BIN=/opt/spirula/spirula SPIRULA_ROMA_MODEL=/opt/models/romav2.0.1.pt \
    NODE_BIN=/usr/local/bin/node SPLAT_TRANSFORM_BIN=/opt/converter/node_modules/@playcanvas/splat-transform/bin/cli.mjs \
    SPLAT_TRANSFORM_GPU_BACKEND=vulkan WORKER_AGENT_LOCK_DIRECTORY=/gpu GPU_LOCK_PATH=/gpu/pipeline.lock
RUN node "$SPLAT_TRANSFORM_BIN" --version && "$SPIRULA_BIN" --version \
    && "$SPIRULA_BIN" dense --help >/dev/null
