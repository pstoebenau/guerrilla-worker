# Cross-check every Windows-specific Rust worker/pipeline path without installing
# a cross toolchain on the developer's host. This is a build-only image.
FROM rust:1.99.0-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add x86_64-pc-windows-gnu
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY rust rust
COPY pipeline/scan-settings.schema.json pipeline/scan-settings.schema.json
ENV CARGO_BUILD_JOBS=4 CC_x86_64_pc_windows_gnu=x86_64-w64-mingw32-gcc
RUN cargo check --locked --workspace --all-targets --target x86_64-pc-windows-gnu
